inventory = {
    "Apples": 10,
    "bread": 20,
    "Milk": 3,
    "Chocolate Bars": 10,

}

def viewInventory():
    print("inventory:")
    for item in sorted(inventory):
        print(f"{item}: {inventory[item]} stock")


viewInventory()


def addProduct(product,stock):
    if product not in inventory:
        inventory[product] = stock
    else:
        inventory[product] += stock


addProduct("Chocolate Bars", 5)
addProduct("Milk", 10)
viewInventory()
